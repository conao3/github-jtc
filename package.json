{
  "name": "github-jtc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "auth:broker:dev": "wrangler dev -c workers/github-auth-broker/wrangler.jsonc",
    "auth:broker:deploy": "wrangler deploy -c workers/github-auth-broker/wrangler.jsonc",
    "build": "vp build",
    "check": "bun run scripts/check.ts",
    "check:vp": "vp check",
    "check:knip": "knip",
    "check:tsc": "tsc --noEmit",
    "test": "vp test",
    "graphql:schema": "mkdir -p graphql && curl -fsSL https://docs.github.com/public/fpt/schema.docs.graphql -o graphql/github.schema.graphql",
    "graphql:codegen": "graphql-codegen --config codegen.ts",
    "desktop:dev": "bun run build && electrobun dev",
    "desktop:run": "bun run build && electrobun run",
    "desktop:build": "bun run build && electrobun build",
    "desktop:build:stable": "bun run build && electrobun build --env=stable"
  },
  "dependencies": {
    "@apollo/client": "^4.3.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "2.1.1",
    "electrobun": "1.16.0",
    "graphql": "^17.0.2",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-call": "2.0.2",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tailwindcss": "4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@types/bun": "1.3.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "knip": "^6.43.0",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.4",
    "@graphql-tools/utils": "^13.2.0",
    "baseline-browser-mapping": "^2.11.34",
    "basic-ftp": "^6.2.3",
    "brace-expansion": "^5.0.12",
    "browserslist": "^4.29.5",
    "js-yaml": "^5.5.0",
    "shell-quote": "^1.12.0",
    "undici": "^8.12.3"
  },
  "packageManager": "bun@1.4.2"
}
